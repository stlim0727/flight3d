[Unit]
Description=Flight3d persistent multiplayer host
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/var/shared/repos/flight3d/.local/ghost-host-runtime
ExecStart=/opt/node/bin/node scripts/ghost-host.mjs
Environment=PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=GHOST_STATE_DIR=/var/shared/repos/flight3d/.local/ghost-host-state
Environment=GHOST_NAME=Maverick
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=20
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
