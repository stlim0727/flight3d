[Unit]
Description=Flight3d standalone multiplayer host
StartLimitIntervalSec=0

[Service]
Type=simple
# Install the extracted package under ~/.local/share/flight3d-ghost/current.
# Override ExecStart with your absolute Node path if it is not in this PATH.
ExecStart=/usr/bin/env node %h/.local/share/flight3d-ghost/current/cli.mjs
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=GHOST_NAME=Maverick
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=15
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
