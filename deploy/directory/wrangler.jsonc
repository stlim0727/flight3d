{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flight3d-room-directory",
  "main": "worker.js",
  "compatibility_date": "2024-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flight3d-rooms",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
