{
  "name": "flight3d",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "bake:cockpit": "node scripts/bake-cockpit-transfer.mjs && node scripts/bake-cockpit-binding.mjs",
    "bake:cockpit-binding": "node scripts/bake-cockpit-binding.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/**/*.test.js",
    "test:flight": "node scripts/test-flight-agent.js",
    "test:flight:visual": "node scripts/test-flight-agent.js --screenshots",
    "test:landing": "node scripts/test-landing-damage.js",
    "test:crash": "node scripts/test-crash-scenarios.js",
    "test:mobile": "node scripts/test-mobile-touch.js",
    "test:demo": "node scripts/test-demo-stepping.js",
    "test:demo-sweep": "node scripts/demo-sweep.mjs --tier core",
    "test:demo-sweep:full": "node scripts/demo-sweep.mjs --tier all",
    "test:lukla": "node scripts/test-lukla-demo-benchmark.mjs",
    "test:cockpit": "node scripts/verify-cockpit-startup.js",
    "test:camera-look": "node scripts/verify-camera-look.mjs",
    "refresh:images": "node scripts/refresh-all-readme-images.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/check-workflow-actions.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4",
    "three-mesh-bvh": "^0.9.2",
    "vite": "^8.3.4",
    "yaml": "2.8.1"
  }
}
