{
  "name": "flight3d",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "bake:cockpit": "node scripts/bake-cockpit-transfer.mjs && node scripts/bake-cockpit-binding.mjs",
    "bake:cockpit-binding": "node scripts/bake-cockpit-binding.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-reporter=./scripts/lib/compactReporter.mjs tests/**/*.test.js",
    "test:bake": "FULL_BAKE_TEST=1 node --test --test-reporter=./scripts/lib/compactReporter.mjs tests/cockpitTransfer.test.js",
    "posthog:dashboard": "node scripts/setup-posthog-dashboard.mjs",
    "wt:new": "node scripts/agent-workflow.mjs wt:new",
    "pr:arc": "node scripts/agent-workflow.mjs pr:arc",
    "pr:mac": "node scripts/agent-workflow.mjs pr:mac",
    "test:replay": "node scripts/verify-replay.mjs",
    "test:flight": "node scripts/test-flight-agent.js",
    "test:pilot": "node scripts/test-pilot-missions.mjs",
    "test:valley": "node scripts/test-valley-pilot.mjs",
    "test:slalom": "node scripts/run-valley-slalom.mjs",
    "test:slalom:courses": "node scripts/validate-valley-courses.mjs",
    "test:flight:visual": "node scripts/test-flight-agent.js --screenshots",
    "test:landing": "node scripts/test-landing-damage.js",
    "test:crash": "node scripts/test-crash-scenarios.js",
    "test:mobile": "node scripts/test-mobile-touch.js",
    "test:demo": "node scripts/test-demo-stepping.js",
    "test:demo-sweep": "node scripts/demo-sweep.mjs --tier core",
    "test:demo-sweep:full": "node scripts/demo-sweep.mjs --tier all",
    "test:lukla": "node scripts/test-lukla-demo-benchmark.mjs",
    "test:cockpit": "node scripts/verify-cockpit-startup.js",
    "test:camera-look": "node scripts/verify-camera-look.mjs",
    "audio:departure": "node scripts/build-gemini-departure-radio.mjs",
    "audio:check": "node scripts/build-gemini-departure-radio.mjs --check",
    "screens:capture": "node scripts/capture-all-ui-screens.mjs",
    "screens:capture:core": "node scripts/capture-all-ui-screens.mjs --tier core",
    "screens:capture:all": "node scripts/capture-all-ui-screens.mjs --all-viewports",
    "screens:capture:all:core": "node scripts/capture-all-ui-screens.mjs --all-viewports --tier core",
    "screens:capture:portrait": "node scripts/capture-all-ui-screens.mjs --viewport mobile-portrait",
    "screens:capture:landscape": "node scripts/capture-all-ui-screens.mjs --viewport mobile-landscape",
    "test:ui-screens": "node scripts/capture-all-ui-screens.mjs --tier core --verify",
    "refresh:images": "node scripts/refresh-all-readme-images.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/check-workflow-actions.mjs",
    "test:multiplayer": "node scripts/test-multiplayer.mjs",
    "multiplayer:ghost": "node scripts/ghost-host.mjs"
  },
  "dependencies": {
    "peerjs": "1.5.5",
    "posthog-js": "^1.445.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4",
    "peer": "1.0.2",
    "three-mesh-bvh": "^0.9.17",
    "vite": "^8.3.4",
    "yaml": "2.8.1"
  }
}
